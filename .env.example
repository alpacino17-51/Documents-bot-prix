# Copie ce fichier en ".env" (même dossier) puis remplis les valeurs.
# Le fichier .env est ignoré par git : il ne sera jamais publié.

# Jeton donné par @BotFather (format 123456789:AAF...)
TELEGRAM_BOT_TOKEN=

# Ton identifiant de conversation (voir README, section "Récupérer le chat_id")
TELEGRAM_CHAT_ID=

# Optionnel : proxy HTTP(S) ou SOCKS5, ex. http://user:pass@host:port ou socks5://host:1080
PROXY_URL=

# Optionnel : en-têtes HTTP supplémentaires au format JSON sur UNE ligne,
# ex. {"Accept-Language": "fr-FR,fr;q=0.9"}
EXTRA_HEADERS_JSON=
